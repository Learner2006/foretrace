# Target Environment: dev, staging, prod
ENV=dev

# Groq Cloud API Secret
GROQ_API_KEY=gsk_...

# Backend Security Keys (Ensure these are long secure strings in prod)
API_KEY=demo_token
ADMIN_API_KEY=demo_admin_token

# Frontend origin URL for CORS verification
FRONTEND_URL=http://localhost:5173

# Redis URI (Optional in dev, required in prod for rate limiting)
# REDIS_URL=redis://localhost:6379

# Sentry DSN for error reporting (Optional)
# SENTRY_DSN=https://your-sentry-dsn
